---
// 作品棚と一部の作品ページは共通レイアウトを使用する。
// 天動説による惑星の運動モデルは public/gallery/member_yasutajan/ の独自HTML/CSS/JSを配信する。
import BaseLayout from '../../../layouts/BaseLayout.astro';

const works = [
  {
    title: '天動説による惑星の運動モデル',
    href: '/gallery/member_yasutajan/geocentric_model_of_planetary_motion.html',
    img: '/images/gallery/member_yasutajan/work.png',
  },
  {
    title: 'サインカーブ・トレーサー',
    href: '/gallery/member_yasutajan/sine_curve_tracer/',
    img: '/images/gallery/member_yasutajan/sine_curve_tracer.jpg',
  },
  {
    title: '機械式時計',
    href: '/gallery/member_yasutajan/mechanical_clock/',
    img: '/images/gallery/member_yasutajan/mechanical_clock.png',
  },
  {
    title: 'ルーレット',
    href: '/gallery/member_yasutajan/roulette/',
    img: '/images/gallery/member_yasutajan/roulette.jpg',
  },
];
---

<BaseLayout title="部員の作品棚：ヤスタジャン｜作品集｜大阪大学レゴ部" bodyClass="left-sidebar" ogImage="/images/gallery/member_yasutajan/work.png">
  <section class="box">
    <h2>ヤスタジャンの作品棚</h2>
    <p></p>
    <div class="row">
      <div class="2u 2u(mobile)">
        <img src="/images/gallery/thumbnail/yasutajan_icon.png" alt="ヤスタジャンのアイコン" />
      </div>
      <div class="10u 10u(mobile)">
        <h3>自己紹介</h3>
        <p>
          記事をご覧いただきありがとうございます！<br>
          年に1回くらいテクニック作品を作っています。<br>
          もしよければ、作品の解説を見ていってください！
        </p>
      </div>
    </div>
  </section>

  <div class="row">
    <div class="6u 12u(mobile)">
      {works.map((w) => (
        <section class="box">
          <h3>{w.title}</h3>
          {w.img && <a href={w.href}><img width="100%" src={w.img} alt={w.title} /></a>}
          <br />
          <a href={w.href}>↑クリックして作品解説を見る↑</a>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
